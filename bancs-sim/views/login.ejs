<%- include('partials/top', { hideNav: true, homeBar: true, devMenu: true }) %>
<div class="demo-bar" id="demo-controls" data-block="demo-controls" role="dialog" aria-label="Developer tools" hidden>
  <div class="demo-head" id="bar-demo-actions" data-block="button-bar">
    <span class="demo-title">Developer tools</span>
    <form method="post" action="/admin/reset" id="form-reset-data" onsubmit="return confirm('Reset all demo data?\n\nEndorsement quotes, saved fees and acceptances are cleared. Latency settings are kept.');">
      <button class="btn btn-danger" type="submit" id="btn-reset-data">Reset data</button>
    </form>
    <span class="demo-note" id="reset-note">Restores every policy and quote to the seed. Latency settings are kept.</span>
  </div>

  <section class="demo-section" id="sec-test-data">
    <h3 class="demo-h">Test data <span class="demo-tag">synthetic, no client PII</span></h3>
    <div class="demo-row" id="bar-dummy-data" data-block="button-bar">
      <span class="demo-label" id="dummy-data-label">Split Fee Cases and Annuities, Aug 2026</span>
      <span class="demo-actions"><a class="btn" id="link-dummy-data-xlsx" href="/login/dummy-data/xlsx" download>Excel</a><a class="btn" id="link-dummy-data-pdf" href="/login/dummy-data/pdf" download>PDF</a></span>
      <span class="demo-note" id="dummy-data-note">4 contracts. Rows 1, 3 and 4 switch the fee to 0 (row 4 opens with Legal Verification blank); row 2 is lapsed (56020).</span>
    </div>
    <div class="demo-row" id="bar-transition-list" data-block="button-bar">
      <span class="demo-label" id="transition-list-label">Relationship Transition List, Aug 2026</span>
      <span class="demo-actions"><a class="btn" id="link-transition-xlsx" href="/login/dummy-data/transition-xlsx" download>Excel</a><a class="btn" id="link-transition-pdf" href="/login/dummy-data/transition-pdf" download>PDF</a></span>
      <span class="demo-note" id="transition-list-note">8 policies moving from adviser 610901 to 620455: open and closed book, lapsed, IMED mismatch, two benefits, 56000 and not found.</span>
    </div>
  </section>

  <form method="post" action="/login/latency" id="form-latency" class="demo-section">
    <h3 class="demo-h">Induced artificial latency <span class="demo-tag">Maker only</span></h3>
    <div class="demo-row" id="bar-latency-profile" data-block="button-bar">
      <%- F.field({ id: 'latency-profile', label: 'Server latency profile', cls: 'demo-field', control: F.select({ id: 'latency-profile', name: 'profile', options: [['off', 'Off'], ['normal', 'Normal'], ['stress', 'Stress']], selected: latency.profile }) }) %>
      <button class="btn" type="submit" name="op" value="apply" id="btn-latency-apply">Apply</button>
      <span class="demo-note" id="hang-note"><b>Server latency</b>: a step returns no sooner than its Normal or Stress time. <b>Client latency</b>: the page freezes for its set time instead; Chrome reports the page as unresponsive after about 15 s.</span>
    </div>
    <details class="latency-panel" id="latency-panel" data-block="section">
      <summary>Per-step settings <span class="demo-note" id="latency-current">Profile <b><%= latency.profile === 'off' ? 'Off' : latency.profile.charAt(0).toUpperCase() + latency.profile.slice(1) %></b> &middot; client latency on <b><%= latency.steps.filter(function (st) { return latency.hang[st.key]; }).length %></b> of <%= latency.steps.length %> steps</span></summary>
      <div class="section-body" id="body-latency-panel" data-block="section-body">
        <div class="latency-table" id="latency-table" data-block="grid">
          <div class="lat-row lat-head" id="latency-row-header"><span class="lat-step">Step</span><span class="lat-obs">Observed in the recording</span><span class="lat-num">Normal (s)</span><span class="lat-num">Stress (s)</span><span class="lat-num">Client latency</span><span class="lat-num">Client (s)</span></div>
          <% latency.steps.forEach(function (st) { %>
          <div class="lat-row" id="latency-row-<%= st.key %>" data-block="field-row">
            <span class="lat-step"><%= st.label %></span>
            <span class="lat-obs"><%= st.observed %></span>
            <%- F.field({ id: 'latency-normal-' + st.key, label: st.label + ' (Normal, seconds)', cls: 'lat-cell', control: F.input({ id: 'latency-normal-' + st.key, name: 'normal[' + st.key + ']', value: latency.normal[st.key], num: true }) }) %>
            <%- F.field({ id: 'latency-stress-' + st.key, label: st.label + ' (Stress, seconds)', cls: 'lat-cell', control: F.input({ id: 'latency-stress-' + st.key, name: 'stress[' + st.key + ']', value: latency.stress[st.key], num: true }) }) %>
            <%- F.field({ id: 'browser-hang-' + st.key, label: st.label + ' (Induced client latency)', cls: 'lat-cell', control: F.select({ id: 'browser-hang-' + st.key, name: 'hang[' + st.key + ']', options: ['No', 'Yes'], selected: latency.hang[st.key] ? 'Yes' : 'No' }) }) %>
            <%- F.field({ id: 'hang-seconds-' + st.key, label: st.label + ' (Induced client latency, seconds)', cls: 'lat-cell', control: F.input({ id: 'hang-seconds-' + st.key, name: 'hangSeconds[' + st.key + ']', value: latency.hangSeconds[st.key], num: true }) }) %>
          </div>
          <% }) %>
        </div>
        <div class="demo-row" id="bar-latency-restore" data-block="button-bar"><button class="btn" type="submit" name="op" value="defaults" id="btn-latency-defaults" formnovalidate>Restore defaults</button><span class="demo-note">Edit any value, then Apply. Waits run on the server, so the screen shows its loading state until the step returns.</span></div>
      </div>
    </details>
  </form>
</div>
<div class="login-box" id="block-login" data-block="form-frame">
  <h1>TCS BaNCS Insurance - Login</h1>
  <form method="post" action="/login" id="form-login">
    <div class="fields one" id="fields-login">
      <%- F.field({ id: 'login-user', label: 'User', mandatory: true, control: F.select({ id: 'login-user', name: 'user', options: [['', '--Select--']].concat(users.map(function (u) { return [u.id, u.name + ' \u2014 ' + (u.kind === 'capturer' ? 'Maker' : 'Checker') + ' (' + u.role + ')']; })) }) }) %>
      <%- F.field({ id: 'login-password', label: 'Password', mandatory: true, control: F.input({ id: 'login-password', name: 'password', type: 'password' }) }) %>
      <%- F.field({ id: 'login-branch', label: 'Branch', control: F.input({ id: 'login-branch', value: 'HO', readonly: true }) }) %>
      <%- F.field({ id: 'login-language', label: 'Language', control: F.input({ id: 'login-language', value: 'ENGLISH', readonly: true }) }) %>
    </div>
    <div class="btnbar button-bar" id="bar-login-actions" data-block="button-bar"><button class="btn" type="submit" id="btn-login">Login</button></div>
  </form>
  <div class="hint" id="login-hint"><% if (book === 'closed') { %>Closed book: password Closed@2026.<% } else { %>Maker: SYS-ADMIN &middot; Checker: PREM-ADM. Any password is accepted.<% } %></div>
</div>
<%- include('partials/bottom') %>
